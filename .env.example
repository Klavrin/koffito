# Expo public vars are bundled into the app; none of these are secrets.

# Supabase is used for authentication only (Project Settings > API in the dashboard).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy name for the same key; still honoured.
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your_key

# The Koffito API (FastAPI), no trailing slash. Every data request goes here.
#   iOS simulator / web:  http://127.0.0.1:8000
#   Android emulator:     http://10.0.2.2:8000
#   physical device:      your Mac's LAN IP (run the API on 0.0.0.0) or `ngrok http 8000`
#   production:           https only
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
