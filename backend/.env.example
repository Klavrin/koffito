# --- Supabase project ---------------------------------------------------------
SUPABASE_URL=https://gxdebgnkrstzxtlvcsix.supabase.co
# Publishable / anon key. Sent as `apikey` on every Data API call; the user's
# own JWT is sent as the bearer so RLS applies.
SUPABASE_ANON_KEY=
# Service role key. Only used by system jobs (matchmaking, venues, reminders).
# Never leaves this server and is never used for a user request.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if the project still signs user JWTs with the legacy HS256
# secret. Projects on asymmetric signing keys (ES256/RS256) are verified
# through /auth/v1/.well-known/jwks.json and can leave this empty.
SUPABASE_JWT_SECRET=
# Shared secret that unlocks the Data API for user-token requests.
# Generate with `select private.rotate_backend_key();` in the Supabase SQL editor.
KOFFITO_BACKEND_KEY=

# --- Server -----------------------------------------------------------------
# "production" refuses plain-HTTP requests (honours X-Forwarded-Proto), "development" allows them.
APP_ENV=development
# Comma-separated list of allowed CORS origins (web builds). Empty = none.
CORS_ORIGINS=
# Default per-user rate limit for every endpoint (slowapi syntax).
RATE_LIMIT_DEFAULT=120/minute
# Background jobs (set to false when running several API replicas; run one worker with jobs).
JOBS_ENABLED=true
# Matchmaking runs once an event is this close (hours); the café is revealed 24h before.
MATCH_LEAD_HOURS=25
LOG_LEVEL=INFO
